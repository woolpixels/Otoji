{
  "name": "otoji",
  "productName": "Otoji",
  "private": true,
  "version": "0.2.1",
  "description": "本地音频处理：从视频里取出声音，把几段声音接起来",
  "author": "liubuhui",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "icon": "electron electron/make-icon.cjs",
    "dist": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.2",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.85.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "local.liubuhui.otoji",
    "productName": "Otoji",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "electronLanguages": [
      "zh_CN",
      "en"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "identity": null,
      "darkModeSupport": false,
      "extendInfo": {
        "CFBundleDisplayName": "Otoji"
      }
    },
    "afterPack": "electron/after-pack.cjs",
    "dmg": {
      "title": "Otoji ${version}",
      "artifactName": "Otoji-${version}-arm64.dmg",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
